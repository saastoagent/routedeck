{
  "name": "@routedeck/core",
  "version": "0.1.0",
  "description": "Browser client, state, contracts, navigation, and conversation primitives for RouteDeck applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saastoagent/routedeck.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/saastoagent/routedeck#readme",
  "bugs": {
    "url": "https://github.com/saastoagent/routedeck/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "pnpm --dir ../.. contracts:generate",
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
