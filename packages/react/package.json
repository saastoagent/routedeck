{
  "name": "@routedeck/react",
  "version": "0.1.0",
  "description": "React bootstrap recovery, bindings, surfaces, navigation, review, and inspector components for RouteDeck.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saastoagent/routedeck.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/saastoagent/routedeck#readme",
  "bugs": {
    "url": "https://github.com/saastoagent/routedeck/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@routedeck/core": "workspace:*"
  },
  "peerDependencies": {
    "@xyflow/react": ">=12.10.0 <13",
    "react": ">=18.3.1 <20",
    "react-dom": ">=18.3.1 <20"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@xyflow/react": "12.11.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
