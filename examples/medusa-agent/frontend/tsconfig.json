{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/routedeck/**/*.ts",
    "src/routedeck/**/*.tsx",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "src/tests/**/*.ts",
    "src/tests/**/*.tsx",
    "src/main.tsx",
    "vite.config.ts"
  ]
}
